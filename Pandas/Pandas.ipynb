    "#Merge Join and concat \n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "students = pd.DataFrame({\n",
    "    'StudentID': [101, 102, 103, 104],\n",
    "    'Name': ['Aman', 'Riya', 'Rohit', 'Neha'],\n",
    "    'City': ['Delhi', 'Mumbai', 'Delhi', 'Pune']\n",
    "})\n",
    "\n",
    "marks = pd.DataFrame({\n",
    "    'StudentID': [101, 102, 104, 105],\n",
    "    'Marks': [85, 92, 88, 90]\n",
    "})\n",
    "print(students)\n",
    "print(marks)\n",
    "\n",
    "# 1. Merge (Inner Join , Left JOin , RIght Join , Outer JOin )\n",
    "\n",
    "#Inner JOin(default) \n",
    "pd.merge(students,marks,on='StudentID')\n",
    "#sirf common student id aaenga \n",
    "\n",
    "#LEft Join \n",
    "\n",
    "pd.merge(students,marks,on='StudentID',how='left')\n",
    "#left table ke sabhi rows likhenge aur agar value missing hui toh NaN ka use karenge \n",
    "\n",
    "#Right Join \n",
    "\n",
    "pd.merge(students,marks,on='StudentID',how='right')\n",
    "\n",
    "#Outer Join \n",
    "pd.merge(students,marks,on='StudentID',how='outer')\n",
    "\n",
    "#2 concat()\n",
    "\n",
    "pd.concat([students,marks]) #Row wise concat\n",
    "\n",
    "pd.concat([students,marks],axis=1)\n",
    "\n",
    "#index based merge \n",
    "students.set_index('StudentID').join(marks.set_index('StudentID'))#jab index same ho join clearn hota hai \n",
    "\n",
    "#merge() is used to combine DataFrames using common columns,\n",
    "# while concat() stacks DataFrames vertically or horizontally.\n",
    "\n",
    "\n"
   ]
