        "#iloc vs Loc\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "df = pd.read_excel('DemoPandasData.xlsx',sheet_name=\"SalesOrders\")\n",
        "# print(df)\n",
        "#Row selection\n",
        "df.iloc[0]\n",
        "\n",
        "#Row+column\n",
        "df.iloc[0,1]\n",
        "\n",
        "df.iloc[:,1:3]\n",
        "\n",
        "#loc(Label-based)\n",
        "\n",
        "df.loc[0]\n",
        "\n",
        "df.loc[1:3,:]\n",
        "\n",
        "df.loc[:,['Region','Units']]\n",
        "\n",
        "#loc with conditioning\n",
        "\n",
        "df.loc[df['Units']>80,['Region','Rep']]#80 se jada units wale region and rep\n",
        "\n",
        "\n"
