    "#Sorting and Counting \n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "df = pd.DataFrame({\n",
    "    'Name': ['Aman', 'Riya', 'Rohit', 'Neha', 'Aman', 'Riya'],\n",
    "    'City': ['Delhi', 'Mumbai', 'Delhi', 'Pune', 'Delhi', 'Mumbai'],\n",
    "    'Marks': [85, 92, 78, 88, 85, 92],\n",
    "    'Age': [20, 21, 19, 22, 20, 21]\n",
    "})\n",
    "\n",
    "#Ascending(default): sort data into ascending order \n",
    "\n",
    "df.sort_values('Marks')#values ko ascending order ke base pe sort karna \n",
    "df.sort_values('Marks' , ascending=False) #sirf marks ke column ko descending order mein sort kiya \n",
    "\n",
    "#Multiple Columns pe sort \n",
    "df.sort_values(['City','Marks'],ascending=False) # Isme Marks ko toh kiya sort lekin saath mein unke align city thi unko bhi sort kardiya \n",
    "\n",
    "#Query : \"Highest marks wale students dikhao \"\n",
    "\n",
    "#Value Counts\n",
    "\n",
    "df['City'].value_counts() # har city mein kite students hai \n",
    "df['City'].value_counts(normalize=True) # Percentage waise dikhata hai \n",
    "\n",
    "#Unique()\n",
    "\n",
    "df['City'].unique() # NUmpy array mein ans aaata hai \n",
    "df['City'].nunique() # count of unique values \n",
    "df['City'].value_counts().head(2)# Top 2 cities with higher count \n",
