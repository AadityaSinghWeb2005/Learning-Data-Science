    "#Group By \n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "df = pd.DataFrame({\n",
    "    'Name': ['Aman', 'Riya', 'Rohit', 'Neha', 'Aman', 'Karan', 'Riya'],\n",
    "    'City': ['Delhi', 'Mumbai', 'Delhi', 'Pune', 'Delhi', 'Mumbai', 'Mumbai'],\n",
    "    'Marks': [85, 92, 78, 88, 85, 90, np.nan],\n",
    "    'Age': [20, 21, 19, 22, 20, np.nan, 21]\n",
    "})\n",
    "# print(df[:])\n",
    "df.groupby('City')['Age'].mean()\n",
    "\n",
    "#Group + Multiple aggregration \n",
    "\n",
    "df.groupby('City')['Marks'].agg(['mean','max','min'])\n",
    "\n",
    "#Groupby + count\n",
    "\n",
    "df.groupby('City').size()\n",
    "\n",
    "#Groupby Multiple columns\n",
    "\n",
    "df.groupby(['City','Name'])['Marks'].mean()\n",
    "\n",
    "#reset_index()\n",
    "df.groupby('City')['Marks'].mean().reset_index()\n",
    "'''\n",
    "Jab hum normal filter karte hai tab index ulte sidhe hote obviously \n",
    "but reset_index() unhe wapis order mein kardeta hai \n",
    "'''\n",
    "\n",
    "#Exercise \n",
    "\n",
    "df.groupby('City')['Marks'].mean()\n",
    "df.groupby(\"City\")['Marks'].max()\n",
    "\n",
    "df.groupby('City').size()#.size() NaN values ko bhi count karta hai \n",
    "df.groupby('City')['Marks'].agg(['mean','max'])\n",
    "\n",
    "df.groupby(\"City\")[\"Marks\"].mean().reset_index()\n",
    "\n",
    "# mcq =[c,c,b,c,b]\n",
    "\n"
   ]
